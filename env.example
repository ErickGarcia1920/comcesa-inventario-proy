NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

POSTGRES_DB=comcesa
POSTGRES_USER=comcesa
POSTGRES_PASSWORD=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_LARGO
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_PORT=6379
BACKEND_PORT=3000

# Solo para desarrollo local. No uses estos valores en produccion.
SESSION_SECRET=REEMPLAZAR_CON_OTRO_SECRETO_ALEATORIO_LARGO
ADMIN_EMAIL=REEMPLAZAR_CON_UN_CORREO_DE_ADMINISTRADOR
ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_LARGA_Y_UNICA
SEED_DEMO_DATA=false

# --- Sincronizacion con Aspel SAE (SQL Server) ---
# Solo se usan en scripts/sync-aspel.js, ejecutado DENTRO de la red local de
# COMCESA (no en el servicio desplegado en la nube, porque el SQL Server de
# SAE no es accesible desde internet). Nunca subas los valores reales al
# repositorio: van solo en tu .env local o en el equipo donde corra la tarea
# programada.
ASPEL_SQLSERVER_HOST=REEMPLAZAR_CON_HOST_DEL_SERVIDOR
ASPEL_SQLSERVER_INSTANCE=REEMPLAZAR_CON_NOMBRE_DE_INSTANCIA
ASPEL_SQLSERVER_DB=SAE80Empre01
ASPEL_SQLSERVER_USER=REEMPLAZAR_CON_USUARIO_DE_SOLO_LECTURA
ASPEL_SQLSERVER_PASSWORD=REEMPLAZAR_CON_LA_CLAVE
ASPEL_SQLSERVER_ENCRYPT=false